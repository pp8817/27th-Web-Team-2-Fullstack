# FE 공유 링크 및 서버 OAuth 콜백의 앱 주소
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# 서버 전용 값. 실제 접속 주소나 비밀번호는 환경 변수로 관리합니다.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_SCOPE=profile_nickname,talk_calendar

# 브라우저에 공개되는 카카오 공유용 JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=
