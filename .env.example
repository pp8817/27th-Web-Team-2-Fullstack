# FE 공유 링크와 OAuth 콜백에 사용할 앱 주소
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Next.js 서버에서 사용하는 PostgreSQL과 Supabase Auth 설정
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 톡캘린더 토큰 갱신용 카카오 키. Supabase에 등록한 카카오 앱과 일치해야 합니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 브라우저에 공개되는 카카오톡 공유용 JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=
